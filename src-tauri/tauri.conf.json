{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waraq",
  "version": "0.2.2",
  "identifier": "com.jake750.waraq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Waraq",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "shortDescription": "Document converter, PDF reader and editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0OTBEQTlBODRDMjhBNkMKUldSc2lzS0VtdHFRZEliOGpNYkhvWjJ1MlNod0dQVkVYL1FlSnpjZUczbU1Na2xmbVhKeitHNkMK",
      "endpoints": [
        "https://github.com/jake750/waraq/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
